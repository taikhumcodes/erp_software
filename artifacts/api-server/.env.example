# ── Application ───────────────────────────────────────────────────────────────
# Port the API server listens on.
PORT=8080

# Node environment (development | production)
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/albunyan_erp?schema=public"

# ── JWT Secrets ────────────────────────────────────────────────────────────────
# Must be long, random, unique strings. Never reuse the same value for both.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_for_access_tokens
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string_for_refresh_tokens

# ── CORS ───────────────────────────────────────────────────────────────────────
# Allowed frontend origin.
# In development, leave empty or set to your frontend URL.
# In production, set to the exact frontend domain (e.g. https://erp.yourcompany.com).
CORS_ORIGIN=http://localhost:3000

# ── Seed (optional) ────────────────────────────────────────────────────────────
# Override the default owner account created by `pnpm run seed`.
# Defaults shown below; remove these lines to use the defaults.
SEED_OWNER_EMAIL=admin@albunyan.com
SEED_OWNER_PASSWORD=Admin@1234
SEED_OWNER_NAME=System Owner
