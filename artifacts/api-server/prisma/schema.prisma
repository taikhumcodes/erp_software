// Prisma schema for Al-Bunyan ERP
// Hardware & Building Materials Trading Company – Kuwait
// Currency: KWD (Kuwaiti Dinar) — 3 decimal precision (Decimal @db.Decimal(15, 3))

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  NOT_INVOICED
  INVOICED
}

// ─────────────────────────────────────────────────────────────────────────────
// Master Dataions
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  SALES
  WAREHOUSE
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum DeliveryOrderStatus {
  DRAFT
  APPROVED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum OrderSource {
  CUSTOMER_PO
  DIRECT
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  CONVERTED
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PaymentType {
  CUSTOMER
  SUPPLIER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CREDIT_CARD
  ONLINE_TRANSFER
  OTHER
}

enum PaymentMode {
  IMMEDIATE
  ADVANCE
  SETTLEMENT
}

enum AttachmentCategory {
  CHEQUE
  BANK_RECEIPT
  HANDWRITTEN_SLIP
  PAYMENT_PROOF
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// Finance Module Enums
// ─────────────────────────────────────────────────────────────────────────────

enum FinanceAccountType {
  CASH
  BANK
  WALLET
  OTHER
  PARTNER_CAPITAL
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LedgerEntryType {
  OPENING_BALANCE
  SALE_PAYMENT
  PURCHASE_PAYMENT
  OWNER_INVESTMENT
  OWNER_WITHDRAWAL
  DEPOSIT
  WITHDRAWAL
  BANK_INTEREST
  BANK_CHARGES
  EXPENSE
  SALARY
  SALARY_ADVANCE
  BONUS
  TRANSFER_IN
  TRANSFER_OUT
  MISC_INCOME
  MISC_EXPENSE
  ADJUSTMENT
  PROFIT_SHARE
}

enum ExpenseFrequency {
  ONCE
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum SalaryStatus {
  PENDING
  PAID
  CANCELLED
}

enum FinanceAuditAction {
  ACCOUNT_CREATED
  ACCOUNT_UPDATED
  ACCOUNT_STATUS_CHANGED
  LEDGER_ENTRY_CREATED
  ADJUSTMENT_CREATED
  TRANSFER_CREATED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  SALARY_GENERATED
  SALARY_PAID
  SALARY_CANCELLED
  SALARY_ADVANCE_CREATED
  PAYMENT_LINKED
}

// ─────────────────────────────────────────────────────────────────────────────
// User & Access Control
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        UserRole @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  nameAr       String?   @map("name_ar")
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  purchases           Purchase[]
  sales               Sale[]
  payments            Payment[]
  cancelledPayments   Payment[]           @relation("CancelledPayments")
  paymentAllocations  PaymentAllocation[]
  uploadedAttachments PaymentAttachment[] @relation("UploadedAttachments")
  deletedAttachments  PaymentAttachment[] @relation("DeletedAttachments")

  // Delivery Order audit relations
  createdDeliveryOrders    DeliveryOrder[]        @relation("DOCreatedBy")
  approvedDeliveryOrders   DeliveryOrder[]        @relation("DOApprovedBy")
  dispatchedDeliveryOrders DeliveryOrder[]        @relation("DODispatchedBy")
  deliveredDeliveryOrders  DeliveryOrder[]        @relation("DODeliveredBy")
  cancelledDeliveryOrders  DeliveryOrder[]        @relation("DOCancelledBy")
  deliveryOrderHistory     DeliveryOrderHistory[]
  purchaseHistory          PurchaseHistory[]
  saleHistory              SaleHistory[]

  // Finance Module relations
  createdFinanceAccounts FinanceAccount[]  @relation("FACreatedBy")
  financeLedgerEntries   FinanceLedger[]
  moneyTransfers         MoneyTransfer[]
  createdExpenses        Expense[]
  paidSalaries           SalaryRecord[]    @relation("SalaryPaidBy")
  createdSalaryAdvances  SalaryAdvance[]   @relation("AdvanceCreatedBy")
  financeAuditLogs       FinanceAuditLog[]

  // Quotation Module relations
  quotations              Quotation[]
  quotationsSalesperson    Quotation[]        @relation("QuotationSalesperson")
  quotationHistory         QuotationHistory[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Product Catalogue
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  nameAr      String?  @map("name_ar")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  nameAr    String?  @map("name_ar")
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Unit {
  id           String   @id @default(cuid())
  name         String   @unique
  nameAr       String?  @map("name_ar")
  abbreviation String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("units")
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  nameAr        String?  @map("name_ar")
  description   String?
  categoryId    String   @map("category_id")
  category      Category @relation(fields: [categoryId], references: [id])
  brandId       String?  @map("brand_id")
  brand         Brand?   @relation(fields: [brandId], references: [id])
  unitId        String   @map("unit_id")
  unit          Unit     @relation(fields: [unitId], references: [id])
  costPrice     Decimal  @map("cost_price") @db.Decimal(15, 3) // KWD
  sellingPrice  Decimal  @map("selling_price") @db.Decimal(15, 3) // KWD
  stockQuantity Decimal  @default(0) @map("stock_quantity") @db.Decimal(15, 3)
  reorderLevel  Decimal  @default(0) @map("reorder_level") @db.Decimal(15, 3)
  countryOfOrigin String? @map("country_of_origin")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  deliveryItems  DeliveryOrderItem[]
  quotationItems QuotationItem[]

  @@map("products")
}

// ─────────────────────────────────────────────────────────────────────────────
// Contacts
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  nameAr      String?  @map("name_ar")
  phone       String?
  email       String?
  address     String?
  creditLimit Decimal  @default(0) @map("credit_limit") @db.Decimal(15, 3) // KWD
  balance     Decimal  @default(0) @db.Decimal(15, 3) // KWD (+ = owes us)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sales          Sale[]
  payments       Payment[]
  deliveryOrders DeliveryOrder[]
  quotations     Quotation[]

  @@map("customers")
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  nameAr    String?  @map("name_ar")
  phone     String?
  email     String?
  address   String?
  balance   Decimal  @default(0) @db.Decimal(15, 3) // KWD (+ = we owe them)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases Purchase[]
  payments  Payment[]

  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────────────────────────
// Purchases
// ─────────────────────────────────────────────────────────────────────────────

model Purchase {
  id                String         @id @default(cuid())
  number            String         @unique // e.g. PO-2024-0001
  supplierId        String         @map("supplier_id")
  supplier          Supplier       @relation(fields: [supplierId], references: [id])
  userId            String         @map("user_id")
  user              User           @relation(fields: [userId], references: [id])
  status            PurchaseStatus @default(DRAFT)
  purchaseDate      DateTime       @default(now()) @map("purchase_date")
  totalAmount       Decimal        @map("total_amount") @db.Decimal(15, 3) // KWD
  discount          Decimal        @default(0) @db.Decimal(15, 3) // KWD
  netAmount         Decimal        @map("net_amount") @db.Decimal(15, 3) // KWD
  notes             String?
  paidAmount        Decimal        @default(0) @map("paid_amount") @db.Decimal(15, 3) // KWD
  outstandingAmount Decimal        @default(0) @map("outstanding_amount") @db.Decimal(15, 3) // KWD
  paymentStatus     PaymentStatus  @default(UNPAID) @map("payment_status")
  paymentMethod     PaymentMethod? @map("payment_method")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  items       PurchaseItem[]
  allocations PaymentAllocation[]
  history     PurchaseHistory[]

  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String   @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(15, 3)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(15, 3) // KWD
  total      Decimal  @db.Decimal(15, 3) // KWD
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("purchase_items")
}

model PurchaseHistory {
  id         String         @id @default(cuid())
  purchaseId String         @map("purchase_id")
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  fromStatus PurchaseStatus? @map("from_status")
  toStatus   PurchaseStatus  @map("to_status")
  
  userId     String         @map("user_id")
  user       User           @relation(fields: [userId], references: [id])
  
  notes      String?
  createdAt  DateTime       @default(now()) @map("created_at")

  @@map("purchase_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sales & Delivery
// ─────────────────────────────────────────────────────────────────────────────

model Sale {
  id                String        @id @default(cuid())
  number            String        @unique // e.g. SO-2026-0001
  customerId        String        @map("customer_id")
  customer          Customer      @relation(fields: [customerId], references: [id])
  userId            String        @map("user_id")
  user              User          @relation(fields: [userId], references: [id])
  status            SaleStatus    @default(DRAFT)
  saleDate          DateTime      @default(now()) @map("sale_date")
  totalAmount       Decimal       @map("total_amount") @db.Decimal(15, 3) // KWD
  discount          Decimal       @default(0) @db.Decimal(15, 3) // KWD
  netAmount         Decimal       @map("net_amount") @db.Decimal(15, 3) // KWD
  paidAmount        Decimal       @default(0) @map("paid_amount") @db.Decimal(15, 3) // KWD
  outstandingAmount Decimal       @default(0) @map("outstanding_amount") @db.Decimal(15, 3) // KWD
  paymentStatus     PaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod     PaymentMethod? @map("payment_method")
  notes             String?
  // Customer PO Number — single source of truth for corporate customer reference
  customerPONumber  String?       @map("customer_po_number")
  internalSONumber  String        @unique @map("internal_so_number") // e.g. SO-2026-0001
  orderSource       OrderSource   @default(DIRECT) @map("order_source")

  deliveryOrderId String?        @map("delivery_order_id")
  deliveryOrder   DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items       SaleItem[]
  allocations PaymentAllocation[]
  history     SaleHistory[]
  quotation   Quotation?

  @@map("sales")
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String   @map("sale_id")
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Decimal  @db.Decimal(15, 3)
  unitPrice Decimal  @map("unit_price") @db.Decimal(15, 3) // KWD
  total     Decimal  @db.Decimal(15, 3) // KWD
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sale_items")
}

model SaleHistory {
  id         String     @id @default(cuid())
  saleId     String     @map("sale_id")
  sale       Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  fromStatus SaleStatus? @map("from_status")
  toStatus   SaleStatus  @map("to_status")
  
  userId     String     @map("user_id")
  user       User       @relation(fields: [userId], references: [id])
  
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at")

  @@map("sale_history")
}

model DeliveryOrder {
  id               String      @id @default(cuid())
  number           String      @unique // DO-2026-000001 (immutable)
  internalSONumber String      @unique @map("internal_so_number") // SO-2026-000001
  customerPONumber String?     @map("customer_po_number")
  orderType        OrderSource @map("order_type")

  customerId           String   @map("customer_id")
  customer             Customer @relation(fields: [customerId], references: [id])
  customerNameSnapshot String   @map("customer_name_snapshot")

  // ── Status ─────────────────────────────────────────────────────────────────
  status        DeliveryOrderStatus @default(DRAFT)
  invoiceStatus InvoiceStatus       @default(NOT_INVOICED) @map("invoice_status")
  paymentMethod PaymentMethod?      @map("payment_method")

  // ── Delivery Details ───────────────────────────────────────────────────────
  deliveryDate    DateTime? @map("delivery_date")
  deliveryAddress String?   @map("delivery_address") // stored independent of customer master
  site            String? // Project or Site
  contactPerson   String?   @map("contact_person")
  contactNumber   String?   @map("contact_number")
  driverName      String?   @map("driver_name")
  vehicleNumber   String?   @map("vehicle_number")

  // ── Notes ──────────────────────────────────────────────────────────────────
  notes         String?
  internalNotes String? @map("internal_notes") @db.Text

  // ── Audit: Created ─────────────────────────────────────────────────────────
  createdById String @map("created_by_id")
  createdBy   User   @relation("DOCreatedBy", fields: [createdById], references: [id])

  // ── Audit: Approved ────────────────────────────────────────────────────────
  approvedById String?   @map("approved_by_id")
  approvedBy   User?     @relation("DOApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @map("approved_at")

  // ── Audit: Dispatched ──────────────────────────────────────────────────────
  dispatchedById String?   @map("dispatched_by_id")
  dispatchedBy   User?     @relation("DODispatchedBy", fields: [dispatchedById], references: [id])
  dispatchedAt   DateTime? @map("dispatched_at")

  // ── Audit: Delivered ───────────────────────────────────────────────────────
  deliveredById String?   @map("delivered_by_id")
  deliveredBy   User?     @relation("DODeliveredBy", fields: [deliveredById], references: [id])
  deliveredAt   DateTime? @map("delivered_at")

  // ── Audit: Cancelled ───────────────────────────────────────────────────────
  cancelledById String?   @map("cancelled_by_id")
  cancelledBy   User?     @relation("DOCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt   DateTime? @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason")

  // ── Timestamps ─────────────────────────────────────────────────────────────
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   DeliveryOrderItem[]
  history DeliveryOrderHistory[]
  sales   Sale[]

  @@map("delivery_orders")
}

model DeliveryOrderItem {
  id              String        @id @default(cuid())
  deliveryOrderId String        @map("delivery_order_id")
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  productId       String        @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])

  productNameSnapshot String @map("product_name_snapshot")
  productCodeSnapshot String @map("product_code_snapshot")
  unitSnapshot        String @map("unit_snapshot")

  quantity Decimal @db.Decimal(15, 3)
  remarks  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("delivery_order_items")
}

model DeliveryOrderHistory {
  id              String        @id @default(cuid())
  deliveryOrderId String        @map("delivery_order_id")
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  fromStatus DeliveryOrderStatus? @map("from_status")
  toStatus   DeliveryOrderStatus  @map("to_status")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("delivery_order_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id     String            @id @default(cuid())
  number String            @unique // e.g. PAY-2026-000001 (immutable)
  type   PaymentType // CUSTOMER | SUPPLIER
  method PaymentMethod
  mode   PaymentMode       @default(IMMEDIATE)
  status TransactionStatus @default(PENDING)

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id])

  supplierId String?   @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  // Finance Account linkage (optional for backward compat with existing payments)
  accountId String?         @map("account_id")
  account   FinanceAccount? @relation(fields: [accountId], references: [id])

  amount          Decimal @db.Decimal(15, 3) // Total Amount
  allocatedAmount Decimal @default(0) @db.Decimal(15, 3)
  remainingAmount Decimal @db.Decimal(15, 3) // amount - allocatedAmount

  paymentDate     DateTime @default(now()) @map("payment_date")
  referenceNumber String?  @map("reference_number")
  notes           String?  @db.Text

  userId String @map("user_id") // Created By
  user   User   @relation(fields: [userId], references: [id])

  cancelledById String?   @map("cancelled_by_id")
  cancelledBy   User?     @relation("CancelledPayments", fields: [cancelledById], references: [id])
  cancelledAt   DateTime? @map("cancelled_at")

  allocations PaymentAllocation[]
  attachments PaymentAttachment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id])

  saleId String? @map("sale_id")
  sale   Sale?   @relation(fields: [saleId], references: [id])

  purchaseId String?   @map("purchase_id")
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  amount Decimal @db.Decimal(15, 3)

  allocatedById String @map("allocated_by_id")
  allocatedBy   User   @relation(fields: [allocatedById], references: [id])

  allocatedAt DateTime @default(now()) @map("allocated_at")

  @@map("payment_allocations")
}

model PaymentAttachment {
  id        String  @id @default(cuid())
  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id])

  category AttachmentCategory @default(OTHER)

  originalName String @map("original_name")
  storedName   String @map("stored_name")
  mimeType     String @map("mime_type")
  size         Int
  path         String

  userId String @map("user_id") // Uploaded By
  user   User   @relation("UploadedAttachments", fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("DeletedAttachments", fields: [deletedById], references: [id])
  deletedAt   DateTime? @map("deleted_at")

  @@map("payment_attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Settings & Configuration
// ─────────────────────────────────────────────────────────────────────────────

model Setting {
  id        String   @id @default(cuid())
  namespace String   // "company", "branding", "document.layout", "document.typography", etc.
  key       String   // "profile", "colors", "header", etc.
  value     Json     // Full JSON blob for the setting group
  version   Int      @default(1)
  companyId String?  @map("company_id") // Future multi-company support
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  history SettingHistory[]

  @@unique([namespace, key, companyId])
  @@map("settings")
}

model SettingHistory {
  id        String   @id @default(cuid())
  settingId String   @map("setting_id")
  setting   Setting  @relation(fields: [settingId], references: [id], onDelete: Cascade)
  version   Int
  oldValue  Json     @map("old_value")
  newValue  Json     @map("new_value")
  changedBy String   @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")

  @@map("setting_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// Finance Module Models
// ─────────────────────────────────────────────────────────────────────────────

model FinanceAccount {
  id             String             @id @default(cuid())
  name           String
  type           FinanceAccountType
  status         AccountStatus      @default(ACTIVE)
  bankName       String?            @map("bank_name")
  accountNumber  String?            @map("account_number")
  branch         String?
  currency       String             @default("KWD")
  // Opening balance is for record-keeping; actual balance is always calculated
  openingBalance Decimal            @default(0) @map("opening_balance") @db.Decimal(15, 3)
  description    String?
  isDefault      Boolean            @default(false) @map("is_default")
  createdById    String             @map("created_by_id")
  createdBy      User               @relation("FACreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  ledgerEntries  FinanceLedger[]
  payments       Payment[]
  transfersFrom  MoneyTransfer[]    @relation("TransferFrom")
  transfersTo    MoneyTransfer[]    @relation("TransferTo")
  expenses       Expense[]
  salaryPayments SalaryRecord[]
  salaryAdvances SalaryAdvance[]
  auditLogs      FinanceAuditLog[]

  @@map("finance_accounts")
}

model FinanceLedger {
  id              String          @id @default(cuid())
  accountId       String          @map("account_id")
  account         FinanceAccount  @relation(fields: [accountId], references: [id])
  entryType       LedgerEntryType @map("entry_type")
  referenceNumber String?         @map("reference_number")
  referenceId     String?         @map("reference_id")
  description     String
  debit           Decimal         @default(0) @db.Decimal(15, 3)
  credit          Decimal         @default(0) @db.Decimal(15, 3)
  // Running balance stored for display performance; recalculated from scratch for exports
  runningBalance  Decimal         @map("running_balance") @db.Decimal(15, 3)
  createdById     String          @map("created_by_id")
  createdBy       User            @relation(fields: [createdById], references: [id])
  remarks         String?
  createdAt       DateTime        @default(now()) @map("created_at")

  @@map("finance_ledger")
}

model MoneyTransfer {
  id              String         @id @default(cuid())
  number          String         @unique // TRF-2026-000001
  fromAccountId   String         @map("from_account_id")
  fromAccount     FinanceAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId     String         @map("to_account_id")
  toAccount       FinanceAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  amount          Decimal        @db.Decimal(15, 3)
  transferDate    DateTime       @default(now()) @map("transfer_date")
  description     String?
  referenceNumber String?        @map("reference_number")
  createdById     String         @map("created_by_id")
  createdBy       User           @relation(fields: [createdById], references: [id])
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("money_transfers")
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  isDefault Boolean   @default(false) @map("is_default")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  expenses  Expense[]

  @@map("expense_categories")
}

model Expense {
  id             String          @id @default(cuid())
  number         String          @unique // EXP-2026-000001
  categoryId     String          @map("category_id")
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  name           String
  vendor         String?
  amount         Decimal         @db.Decimal(15, 3)
  accountId      String          @map("account_id")
  account        FinanceAccount  @relation(fields: [accountId], references: [id])
  expenseDate    DateTime        @default(now()) @map("expense_date")
  description    String?
  attachmentPath String?         @map("attachment_path")
  status         ExpenseStatus   @default(PAID)
  // Recurring expense support
  isRecurring    Boolean         @default(false) @map("is_recurring")
  frequency      ExpenseFrequency?
  nextDueDate    DateTime?       @map("next_due_date")
  parentId       String?         @map("parent_id")
  parent         Expense?        @relation("RecurringExpenses", fields: [parentId], references: [id])
  children       Expense[]       @relation("RecurringExpenses")
  createdById    String          @map("created_by_id")
  createdBy      User            @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("expenses")
}

model Employee {
  id           String         @id @default(cuid())
  employeeId   String         @unique @map("employee_id") // EMP-001
  name         String
  phone        String?
  department   String?
  designation  String?
  joiningDate  DateTime?      @map("joining_date")
  basicSalary  Decimal        @map("basic_salary") @db.Decimal(15, 3)
  allowances   Decimal        @default(0) @db.Decimal(15, 3)
  deductions   Decimal        @default(0) @db.Decimal(15, 3)
  status       EmployeeStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  salaryRecords SalaryRecord[]
  advances      SalaryAdvance[]

  @@map("employees")
}

model SalaryRecord {
  id          String          @id @default(cuid())
  number      String          @unique // SAL-2026-000001
  employeeId  String          @map("employee_id")
  employee    Employee        @relation(fields: [employeeId], references: [id])
  month       Int
  year        Int
  basicSalary Decimal         @map("basic_salary") @db.Decimal(15, 3)
  allowances  Decimal         @db.Decimal(15, 3)
  deductions  Decimal         @db.Decimal(15, 3)
  bonus       Decimal         @default(0) @db.Decimal(15, 3)
  overtime    Decimal         @default(0) @db.Decimal(15, 3)
  // netSalary = basicSalary + allowances + bonus + overtime - deductions
  netSalary   Decimal         @map("net_salary") @db.Decimal(15, 3)
  accountId   String?         @map("account_id")
  account     FinanceAccount? @relation(fields: [accountId], references: [id])
  status      SalaryStatus    @default(PENDING)
  paidAt      DateTime?       @map("paid_at")
  paidById    String?         @map("paid_by_id")
  paidBy      User?           @relation("SalaryPaidBy", fields: [paidById], references: [id])
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([employeeId, month, year]) // Prevent duplicate salary for same month
  @@map("salary_records")
}

model SalaryAdvance {
  id          String         @id @default(cuid())
  number      String         @unique // ADV-2026-000001
  employeeId  String         @map("employee_id")
  employee    Employee       @relation(fields: [employeeId], references: [id])
  amount      Decimal        @db.Decimal(15, 3)
  accountId   String         @map("account_id")
  account     FinanceAccount @relation(fields: [accountId], references: [id])
  advanceDate DateTime       @default(now()) @map("advance_date")
  reason      String?
  recovered   Boolean        @default(false)
  recoveredAt DateTime?      @map("recovered_at")
  createdById String         @map("created_by_id")
  createdBy   User           @relation("AdvanceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("salary_advances")
}

model FinanceAuditLog {
  id          String              @id @default(cuid())
  action      FinanceAuditAction
  module      String              // "ACCOUNT" | "EXPENSE" | "SALARY" | "TRANSFER" | "PAYMENT"
  referenceId String?             @map("reference_id")
  reference   String?             // Human-readable: EXP-2026-000001
  amount      Decimal?            @db.Decimal(15, 3)
  accountId   String?             @map("account_id")
  account     FinanceAccount?     @relation(fields: [accountId], references: [id])
  userId      String              @map("user_id")
  user        User                @relation(fields: [userId], references: [id])
  oldValue    Json?               @map("old_value")
  newValue    Json?               @map("new_value")
  reason      String?
  remarks     String?
  ipAddress   String?             @map("ip_address")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@map("finance_audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Quotation Module
// ─────────────────────────────────────────────────────────────────────────────

model Quotation {
  id                String          @id @default(cuid())
  number            String          @unique // QT-2026-000001
  customerId        String?         @map("customer_id")
  customer          Customer?       @relation(fields: [customerId], references: [id])
  customerName      String?         @map("customer_name")
  customerNameAr    String?         @map("customer_name_ar")
  quotationBy       String?         @map("quotation_by")
  quotationByAr     String?         @map("quotation_by_ar")
  quotationByAddress String?        @map("quotation_by_address")
  userId            String          @map("user_id")
  user              User            @relation(fields: [userId], references: [id])
  salespersonId     String?         @map("salesperson_id")
  salesperson       User?           @relation("QuotationSalesperson", fields: [salespersonId], references: [id])
  status            QuotationStatus @default(DRAFT)
  quotationDate     DateTime        @default(now()) @map("quotation_date")
  validityDate      DateTime?       @map("validity_date")
  referenceNumber   String?         @map("reference_number")
  customerReference String?         @map("customer_reference")

  // Pricing (no tax — Kuwait deployment)
  totalAmount       Decimal         @map("total_amount") @db.Decimal(15, 3)
  discount          Decimal         @default(0) @db.Decimal(15, 3)
  roundOff          Decimal         @default(0) @map("round_off") @db.Decimal(15, 3)
  grandTotal        Decimal         @map("grand_total") @db.Decimal(15, 3)

  notes              String?  @db.Text
  termsAndConditions String?  @map("terms_and_conditions") @db.Text

  // Customer snapshot fields (editable per quotation)
  contactPerson     String?  @map("contact_person")
  phone             String?
  email             String?
  address           String?  @db.Text
  country           String?

  // Conversion tracking
  convertedToSaleId String?  @unique @map("converted_to_sale_id")
  convertedToSale   Sale?    @relation(fields: [convertedToSaleId], references: [id])
  convertedAt       DateTime? @map("converted_at")
  convertedById     String?  @map("converted_by_id")

  // Revision support (future-ready)
  revisionNumber    Int       @default(1) @map("revision_number")
  parentQuotationId String?   @map("parent_quotation_id")
  parentQuotation   Quotation? @relation("QuotationRevisions", fields: [parentQuotationId], references: [id])
  revisions         Quotation[] @relation("QuotationRevisions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   QuotationItem[]
  history QuotationHistory[]

  @@map("quotations")
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String    @map("quotation_id")
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String?   @map("product_id")
  product         Product?  @relation(fields: [productId], references: [id])
  description     String?
  productNameAr   String?   @map("product_name_ar")
  countryOfOrigin String?   @map("country_of_origin")
  quantity        Decimal   @db.Decimal(15, 3)
  unitPrice       Decimal   @map("unit_price") @db.Decimal(15, 3)
  amount          Decimal   @db.Decimal(15, 3)
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("quotation_items")
}

model QuotationHistory {
  id          String           @id @default(cuid())
  quotationId String           @map("quotation_id")
  quotation   Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  action      String           // CREATE, EDIT, STATUS_CHANGE, PRINT, DOWNLOAD, CONVERT, CANCEL, DELETE, DUPLICATE
  fromStatus  QuotationStatus? @map("from_status")
  toStatus    QuotationStatus? @map("to_status")
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id])
  notes       String?
  oldValue    Json?            @map("old_value")
  newValue    Json?            @map("new_value")
  ipAddress   String?          @map("ip_address")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("quotation_history")
}
