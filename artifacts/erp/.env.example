# ── Vite dev server ────────────────────────────────────────────────────────────
# These variables must be present in the shell environment before running Vite.
# Vite reads them via process.env inside vite.config.ts (not via .env file loading).
#
# Usage (Linux / macOS):
#   export PORT=3000 BASE_PATH=/
#   pnpm run dev
#
# Or inline:
#   PORT=3000 BASE_PATH=/ pnpm run dev
#
# Or use dotenv-cli:
#   npx dotenv-cli -e .env -- pnpm run dev

# Port for the Vite dev server.
PORT=3000

# Base URL path. Use / for local development.
# In a sub-path deployment (e.g. behind a reverse proxy at /erp/) set this to /erp/.
BASE_PATH=/
